<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 데스크톱 확인용 빌드에서만 쓰인다.
  audioplayers_windows 플러그인이 NuGet 패키지를 받아야 하는데,
  이 PC의 전역 NuGet 설정에 저장소 주소가 없어 빌드가 실패했다.
  전역 설정을 건드리지 않도록 프로젝트에 두었다.
  안드로이드 빌드에는 영향이 없다.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
